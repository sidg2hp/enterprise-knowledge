# Backend
KNOWLEDGE_STORE_PATH=/app/data/documents.json
CORS_ORIGINS=http://localhost:3000

# Frontend (exposed to the browser, so never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Retrieval and optional model integrations
KNOWLEDGE_RETRIEVER_MODE=bm25
KNOWLEDGE_LEXICAL_WEIGHT=0.7
KNOWLEDGE_VECTOR_WEIGHT=0.3
OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Optional Neo4j GraphRAG context (enable the Compose graph profile separately)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
